{
  "name": "myddleware/myddleware",
  "description": "Myddleware is the customisable free open-source platform that facilitates data migration and synchronisation between applications via connectors.",
  "type": "project",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
    "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "api-platform/core": "^4.0",
    "automattic/woocommerce": "^3.1",
    "babdev/pagerfanta-bundle": "^4.5",
    "beberlei/doctrineextensions": "^1.3",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.1",
    "doctrine/doctrine-migrations-bundle": "^3.2",
    "doctrine/orm": "^3.0",
    "friendsofsymfony/jsrouting-bundle": "^3.2",
    "getbrevo/brevo-php": "^2.0",
    "google/cloud-bigquery": "^1.34",
    "guzzlehttp/guzzle": "^7.9.2",
    "hautelook/alice-bundle": "^2.17",
    "hubspot/api-client": "^12.0",
    "illuminate/encryption": "^11.0",
    "laminas/laminas-code": "4.17.0",
    "laminas/laminas-hydrator": "^4.15",
    "laminas/laminas-stdlib": "3.21.0",
    "lexik/jwt-authentication-bundle": "^3.0",
    "nelmio/cors-bundle": "^2.2",
    "pagerfanta/pagerfanta": "^4.5",
    "phpdocumentor/reflection-docblock": "^5.3",
    "prestashop/prestashop-webservice-lib": "dev-master",
    "psr/log": "^3.0",
    "roave/better-reflection": "^6.5",
    "sendinblue/api-v3-sdk": "^8.4",
    "shapecode/cron-bundle": "^8.0",
    "spiriitlabs/form-filter-bundle": "^12.0",
    "stof/doctrine-extensions-bundle": "^1.12",
    "symfony/asset": "7.*",
    "symfony/console": "7.*",
    "symfony/debug-bundle": "7.*",
    "symfony/dotenv": "7.*",
    "symfony/expression-language": "7.*",
    "symfony/flex": "^2.0",
    "symfony/form": "7.*",
    "symfony/framework-bundle": "7.*",
    "symfony/http-client": "7.*",
    "symfony/http-foundation": "7.*",
    "symfony/mailer": "7.*",
    "symfony/mime": "7.*",
    "symfony/monolog-bundle": "^3.8",
    "symfony/property-access": "7.*",
    "symfony/property-info": "7.*",
    "symfony/rate-limiter": "7.*",
    "symfony/requirements-checker": "^2.0",
    "symfony/security-bundle": "7.*",
    "symfony/serializer": "7.*",
    "symfony/stopwatch": "7.*",
    "symfony/translation": "7.*",
    "symfony/twig-bundle": "7.*",
    "symfony/validator": "7.*",
    "symfony/web-profiler-bundle": "7.*",
    "symfony/webpack-encore-bundle": "^2.0",
    "symfony/yaml": "7.*",
    "twig/extra-bundle": "^3.4",
    "twig/twig": "^3.4"
  },
    "repositories": [
    ],
    "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "^3.13",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-doctrine": "^1.3",
    "phpstan/phpstan-symfony": "^1.3",
    "phpunit/phpunit": "^9.5",
    "rector/rector": "^1.2",
    "symfony/browser-kit": "7.*",
    "symfony/css-selector": "7.*",
    "symfony/maker-bundle": "^1.48",
    "symfony/phpunit-bridge": "7.*"
  },
    "scripts": {
        "post-root-package-install": [
            "SymfonyStandard\\Composer::hookRootPackageInstall"
        ],
        "post-install-cmd": [
        ],
        "post-update-cmd": [
        ],
        "auto-scripts": {
      "requirements-checker": "script",
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
    },
    "config": {
        "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "symfony/flex": true,
      "phpstan/extension-installer": true,
      "php-http/discovery": true
    },
        "preferred-install": {
          "*": "dist"
      },
      "sort-packages": true

    },
    "extra": {
        "symfony-bin-dir": "bin",
        "symfony-app-dir": "app",
        "symfony-web-dir": "web",
        "symfony-var-dir": "var",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "branch-alias": {
            "dev-master": "3.2-dev"
        },
        "symfony": {
          "allow-contrib": false,
          "require": "7.*"
        }
    }
}
